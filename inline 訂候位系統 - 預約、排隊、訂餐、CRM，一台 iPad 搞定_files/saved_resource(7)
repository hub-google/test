}

#navigation > ul > li > a.sf-with-ul:after{
    content: '';
    position: absolute;
    top: 50%;
    margin-top: -5px;
    right: 6px;
    font-size: 11px;
    content: '\f107';
    font-family: 'FontAwesome';
    display: none !important;
