/* Topbar
/* ------------------------------------------------------------------------ */
#topbar{
    position: relative;
    z-index: 99999;
    background: #f9f9f9;
    color: #777777;
    min-height: 40px;
    line-height: 40px;
}

#topbar .topbar-col1{
    float: left;
    margin: 0;
